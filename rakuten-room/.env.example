# 楽天ウェブサービスのアプリID（https://webservice.rakuten.co.jp/app/list で確認）
# 2026年時点では UUID 形式。旧仕様の「数字20桁」ではない
RAKUTEN_APP_ID=
# 楽天ウェブサービスのアクセスキー（同じ画面の Access Key）
# 2026-07-01版のAPIから、アプリIDと必ずセットで送る必要がある
RAKUTEN_ACCESS_KEY=
# アプリ設定の「許可されたウェブサイト」。Originヘッダとして送られ、登録値と照合される
# 未設定・不一致だと 403 になる（Application URL ではないので注意）
RAKUTEN_APP_URL=
# 楽天アフィリエイトID（発行済みのもの。空でも動くがリンクが非アフィリになる）
RAKUTEN_AFFILIATE_ID=
# 任意: 紹介文をLLMで自然化する場合のみ。未設定ならルールベース生成のみで完結する
ANTHROPIC_API_KEY=
# 任意: 投稿時刻の通知先（Discord / Slack の Incoming Webhook URL）
ROOM_WEBHOOK_URL=
